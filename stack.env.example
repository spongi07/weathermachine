# Weather Machine — stack variables (Portainer: "Environment variables" section,
# or `cp stack.env.example .env` for plain docker compose). Never commit secrets.

# --- Required ---------------------------------------------------------------
# PostgreSQL password (audit storage). Generate: openssl rand -hex 24
WM_DB_PASSWORD=
# Contact for the NOAA/NWS User-Agent (e-mail or URL). Required by NOAA's API policy.
WM_CONTACT=

# --- Strongly recommended ------------------------------------------------------
# Operator token for the kill switch (dashboard button + POST /api/v1/kill-switch,
# header X-WM-Admin-Token). Empty disables operator commands. Generate: openssl rand -hex 32
WM_ADMIN_TOKEN=
# HTTP Basic auth for dashboard/API/metrics (set both or neither).
# Health probes (/healthz, /readyz) stay open for the orchestrator.
WM_DASHBOARD_USER=
WM_DASHBOARD_PASSWORD=

# --- Optional -------------------------------------------------------------------
# Image tag to deploy (pin a version or commit tag for reproducible rollbacks).
WM_IMAGE_TAG=latest
# Host port of the dashboard.
WM_HTTP_PORT=8080
# Probability model file. Unset = /data/models/eham.json, trained automatically
# on first start from IEM METAR history (a few minutes; loaded without a
# restart) and retrained in the background every 30 days.
WM_MODEL_PATH=
# false = never download history / train automatically (no model = no trades).
WM_MODEL_AUTO_TRAIN=true
# Day-1 forecast from Open-Meteo. The model uses it ONLY if the out-of-sample
# test at training shows it improves decisions (see the report in
# /data/research/eham-survival.md). false = never fetched or evaluated.
WM_FORECAST=true
# Open-Meteo model (Previous Runs API). gfs_global has the longest history.
WM_FORECAST_MODEL=gfs_global
# Open-Meteo's free tier is for non-commercial use. For real-money trading buy
# a subscription and put its key here (switches to the customer host).
WM_OPEN_METEO_API_KEY=
# Free KNMI Data Platform key (https://developer.dataplatform.knmi.nl/) for the
# airport's ten-minute readings, strategy K's input. Empty: K does nothing.
WM_KNMI_API_KEY=
# Log format: json (recommended in containers) or pretty.
WM_LOG_FORMAT=json
# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,sqlx=warn,hyper=warn,reqwest=warn,tungstenite=warn
# Days of nightly database dumps kept in the `backups` volume.
WM_BACKUP_KEEP_DAYS=14
# Include the replay journal (large: every engine input) in nightly backups.
WM_BACKUP_JOURNAL=false
# Days of order-book updates kept in the replay journal (0 = keep forever).
WM_JOURNAL_RETENTION_DAYS=7

# --- Strategy G's live twin (REAL MONEY; off by default) ----------------------------
# Guide: docs/deployment/live.md. With WM_LIVE_G=true G_live bids only while
# every check on the dashboard's LIVE panel passes. Only G_live trades real
# money; every other strategy stays on paper.
WM_LIVE_G=false
# The signer's private key (0x… hex) of the Polymarket account. Read once at
# start, never logged or stored. Treat it like the money it controls.
WM_POLY_PRIVATE_KEY=
# The Polymarket wallet that holds the money (the address Polymarket shows as
# your deposit address; for an e-mail/Magic login the proxy wallet).
WM_POLY_FUNDER=
# 0 = EOA (the key's own address holds the money), 1 = proxy (e-mail/Magic
# login), 2 = Gnosis safe (browser wallet).
WM_POLY_SIG_TYPE=1

# --- Notifications (Pushover; optional) -----------------------------------------------
# A message for every settled market of the live twin (what it held, the
# result, since going live, the venue balance) and for every live order that
# bought shares. Both secret: the API token of an application you create at
# pushover.net and your user key (30 letters and digits each; the same user
# key as dailyprofit's PUSHOVER_USER works). Unset = no messages. Check them
# with `weather-machine notify-test`. A wrong value is a warning, never a
# refusal to start.
WM_PUSHOVER_TOKEN=
WM_PUSHOVER_USER=
# whose results: live (the default) | all | strategy ids or letters, e.g. GL,G
WM_PUSHOVER_STRATEGIES=live
